# ==============================================================================
# FoodReels Backend Configuration (.env)
# ==============================================================================

# Server Port (Render automatically sets PORT in production)
PORT=3001
NODE_ENV=development

# Allowed Frontend URL for Production CORS (e.g. your Vercel deployment)
FRONTEND_URL=http://localhost:5173

# Secret Key for JWT token signing (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# MongoDB Atlas or Local MongoDB Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodreels?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/foodreels

# Google Gemini API Key for AI Food Descriptions & Intelligent Recommendations
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ImageKit Configuration for Video & Image Uploads
# Sign up free at: https://imagekit.io/
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id